<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/txtQrTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="INV-0001"
        android:textColor="@color/text_main"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtQrInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="QR pesanan"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/imgQr"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_product_thumb"
        android:contentDescription="QR Pesanan"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_box" />

    <TextView
        android:id="@+id/txtQrToken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="Kode Pengambilan"
        android:textColor="@color/text_muted"
        android:textSize="11.5sp" />
</LinearLayout>
