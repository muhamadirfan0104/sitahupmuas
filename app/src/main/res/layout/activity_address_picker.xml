<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="24dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pilih Titik Alamat"
        android:textColor="@color/text_main"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtSelectedPoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Titik dipilih"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <org.osmdroid.views.MapView
        android:id="@+id/mapPicker"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/btnUsePoint"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_orange"
        android:gravity="center"
        android:text="Gunakan Titik Ini"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_outline_orange"
        android:gravity="center"
        android:text="Kembali"
        android:textColor="@color/primary"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
